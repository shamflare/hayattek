**/.venv
**/.next
**/.expo
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/test-results
**/playwright-report
**/*.log
**/*.tsbuildinfo
.git
.env
.env.*
!.env.example
infra/prodcheck/.local
backend/media
backend/staticfiles
apps/mobile
docs
