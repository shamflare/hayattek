{
  "expo": {
    "name": "حياة",
    "slug": "hayat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hayat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hayattek.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يستخدم تطبيق حياة الميكروفون لتسجيل الزيارة الطبية في HayatTek AI فقط بعد ضغط الطبيب على «بدء» وبموافقة المريض. لا يُسجَّل أي صوت في الخلفية.",
        "NSCameraUsageDescription": "يحتاج تطبيق حياة إلى الكاميرا لمسح رمز البطاقة الصحية."
      }
    },
    "android": {
      "package": "com.hayattek.app",
      "adaptiveIcon": {
        "backgroundColor": "#157f74",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "ar"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج تطبيق حياة إلى الكاميرا لمسح رمز البطاقة الصحية.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#157f74",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يستخدم تطبيق حياة الميكروفون لتسجيل الزيارة الطبية في HayatTek AI فقط بعد ضغط الطبيب على «بدء» وبموافقة المريض. لا يُسجَّل أي صوت في الخلفية.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
